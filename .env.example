# Application environment
AJNA_ENV=development
AJNA_DEMO_MODE=true

# API
AJNA_API_PORT=3000
AJNA_API_HOST=localhost
AJNA_JWT_SECRET=change_me_to_a_secure_random_string_32_bytes_min

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ajna_dev
AJNA_DATABASE_POOL_SIZE=10

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379/0

# Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AJNA_KEK_BASE64=change_me_to_32_byte_base64_encoded_key

# Scoring service
AJNA_SCORING_URL=http://localhost:8000
AJNA_SCORING_TOKEN=change_me_to_scoring_service_bearer_token

# Wearable simulator
AJNA_WEARABLE_DEMO_ENABLED=true
AJNA_WEARABLE_BATCH_SIZE_MAX=60

# Monitor Me (acoustic)
AJNA_MONITOR_SESSION_CAP_SEC=600
AJNA_MONITOR_FLAGS_PER_SESSION_MAX=100
AJNA_MONITOR_FLAG_RETENTION_DAYS=30
AJNA_REVIEW_SLA_MIN=4320

# Population aggregation
AJNA_POPULATION_SUPPRESSION_K=10
AJNA_POPULATION_AGGREGATE_ENABLED=true

# Care gaps
AJNA_CAREGAP_DETECTION_ENABLED=true

# Logging
AJNA_LOG_LEVEL=debug

# CORS
AJNA_CORS_ORIGIN=http://localhost:3001,exp://

# Security
AJNA_RATE_LIMIT_WINDOW_MS=60000
AJNA_RATE_LIMIT_MAX_REQUESTS=100
AJNA_RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000
