{
  "name": "ajna-api",
  "version": "0.1.0",
  "description": "Ajna API: privacy-first population health platform",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "contract:generate": "nest swagger && node scripts/write-contract.js",
    "contract:check": "node scripts/check-contract.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/rate-limit": "^4.1.1",
    "fastify": "^4.25.2",
    "fastify-rate-limit": "^9.1.0",
    "zod": "^3.22.4",
    "nestjs-zod": "^3.0.0",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "reflect-metadata": "^0.1.13",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "swagger-cli": "^4.0.4"
  }
}
