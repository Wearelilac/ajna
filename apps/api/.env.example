# Application Environment
AJNA_ENV=development
AJNA_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Database (B1.2)
DATABASE_URL=postgres://user:password@localhost:5432/ajna

# Redis (for BullMQ workers in B1.4)
REDIS_URL=redis://localhost:6379

# Encryption (B1.3, 00-data-protection-model.md)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AJNA_KEK_BASE64=YOUR_32_BYTE_KEY_IN_BASE64_HERE

# JWT (B1.3)
AJNA_JWT_SECRET=your-jwt-secret-change-in-production

# Scoring Service (B1.4)
AJNA_SCORING_URL=http://localhost:8001
AJNA_SCORING_TOKEN=your-scoring-token
