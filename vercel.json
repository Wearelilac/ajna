{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "installCommand": "npm install"
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "npm run build",
      "installCommand": "npm install",
      "bindings": [
        {
          "type": "service",
          "service": "scoring",
          "format": "url",
          "env": "AJNA_SCORING_URL"
        }
      ]
    },
    "scoring": {
      "root": "services/scoring",
      "runtime": "python",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
